+// runTransaction is the only Provider transaction entry (SQL and version-table
+// creation). Default upstream behavior is unchanged when no host runner is set.
+func (p *Provider) runTransaction(ctx context.Context, conn *sql.Conn, work func(database.DBTxConn) error) error {
+	if p.cfg.transactionRunner != nil {
+		return p.cfg.transactionRunner(ctx, conn, work)
+	}
+	return beginTx(ctx, conn, func(tx *sql.Tx) error { return work(tx) })
+}
+
+// ValidateSQLMigrations parses all sources without touching the database.
+// StudyFlow uses this before registering an unversioned baseline.
+func (p *Provider) ValidateSQLMigrations() error {
+	for _, m := range p.migrations {
+		if m.Type != TypeSQL {
+			return errors.New("only SQL upgrades are supported")
+		}
+		if err := p.prepareMigration(p.fsys, m, true); err != nil {
+			return fmt.Errorf("prepare %s: %w", m.Source, err)
+		}
+	}
+	return nil
+}
