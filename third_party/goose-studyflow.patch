+// TransactionRunner lets the host own transaction cleanup on the connection
+// already borrowed by Provider. The host must not close a healthy connection.
+type TransactionRunner func(context.Context, *sql.Conn, func(database.DBTxConn) error) error
+
+// WithTransactionRunner is a StudyFlow extension. Only transactional SQL
+// migrations are supported with this option; no independent transaction is opened.
+func WithTransactionRunner(run TransactionRunner) ProviderOption {
+	return configFunc(func(c *config) error {
+		if run == nil {
+			return errors.New("nil transaction runner")
+		}
+		c.transactionRunner = run
+		return nil
+	})
+}
